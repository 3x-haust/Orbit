    },
    "Orbit Helper keeps the limit on its own. Discharging always stops when Orbit quits.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit 도우미가 혼자서도 한도를 지켜요. 방전은 Orbit을 끄면 항상 멈춰요."
          }
