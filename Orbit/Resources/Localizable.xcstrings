      }
    },
    "Orbit snippets": {
      "extractionState": "manual"
    },
    "Orbit starts with your Mac, runner and all.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac을 켜면 러너와 함께 Orbit이 시작돼요."
          }
        }
      }
    },
    "Orbit turned on closed-lid mode last time and didn’t get to turn it off. Restore normal sleep?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번에 Orbit이 덮개 닫힘 모드를 켠 채로 끄지 못했어요. 잠자기를 원래대로 돌릴까요?"
          }
        }
      }
    },
    "Orbit wants to keep your Mac awake with the lid closed.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit이 덮개를 닫아도 Mac을 깨워두려고 해요."
          }
        }
      }
    },
    "Orbit wants to restore normal sleep when the lid closes.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit이 덮개를 닫으면 잠자도록 되돌리려고 해요."
          }
        }
      }
    },
    "Orbit watches for your keywords and types the snippet in their place.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit이 키워드를 알아보고 그 자리에 스니펫을 넣어요."
          }
        }
      }
    },
    "Orbit works without these — only the features that need them will ask.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "없어도 Orbit은 동작해요 — 필요한 기능만 그때 물어봐요."
          }
        }
      }
    },
