      }
    },
    "What's playing, with controls, and what's left on today's calendar.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중인 곡과 컨트롤, 오늘 남은 일정을 보여줘요."
          }
        }
      }
    },
    "What’s on the clipboard": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 있는 내용"
          }
        }
      }
    },
    "What’s playing, on your desktop — from any app, in a look that’s yours.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 듣는 곡을 데스크탑에 — 어떤 앱이든, 내 마음대로 꾸민 모습으로."
          }
        }
      }
    },
    "Wheel speed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휠 속도"
          }
        }
      }
    },
    "When Orbit Quits": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit을 종료하면"
          }
        }
      }
    },
    "When an app puts an icon in the menu bar for the first time, it goes straight to Hidden.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 메뉴 막대에 처음 아이콘을 띄우면 바로 숨김으로 보내요."
          }
        }
      }
    },
    "When it’s already in that language": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 그 언어일 때"
          }
        }
      }
    },
    "When macOS asks for Touch ID or your password — System Settings, installers, apps — Orbit checks your face in the notch and fills the password in for you. Only Apple’s own password prompts, one try each; Touch ID and typing still work.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 Touch ID나 암호를 물어볼 때(시스템 설정, 설치 프로그램, 앱) 노치에서 얼굴을 확인하고 암호를 대신 넣어줘요. Apple의 암호 요청 창에만, 창마다 한 번씩만 해요. Touch ID나 직접 입력도 그대로 돼요."
          }
        }
      }
    },
    "When sound plays through a monitor over HDMI or DisplayPort, which macOS can't turn up.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HDMI나 DisplayPort로 모니터에서 소리가 날 때요. macOS는 이 음량을 못 바꿔요."
          }
        }
      }
    },
    "When the song changes": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡이 바뀔 때"
          }
        }
      }
    },
    "When your face matches at the lock screen, Orbit types your login password for you. It only looks when you press a key, touch the trackpad or wake the screen — never right as you lock it.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에서 얼굴이 맞으면 Orbit이 로그인 암호를 대신 입력해요. 키를 누르거나 트랙패드를 만지거나 화면이 깨어날 때만 확인하고, 잠근 직후에는 확인하지 않아요."
          }
        }
      }
    },
    "Where it sits": {
      "extractionState": "manual",
