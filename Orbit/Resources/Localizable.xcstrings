    "Opens ZIP, 7Z, RAR, TAR, GZ, BZ2, XZ, ZST, LZ, ISO, DMG, CAB, LHA, CPIO and split parts (.001).": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP, 7Z, RAR, TAR, GZ, BZ2, XZ, ZST, LZ, ISO, DMG, CAB, LHA, CPIO, 나눠진 조각(.001)까지 풀 수 있어요."
          }
        }
      }
    },
    "Opens anywhere — Mac, Windows, phones.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나 열려요. Mac, Windows, 휴대폰 모두."
