    "A CSV, .1pux or Bitwarden .json you already have.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 가지고 있는 CSV, .1pux, Bitwarden .json 파일."
          }
        }
      }
    },
    "A JSON file Raycast can read too.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Raycast에서도 읽을 수 있는 JSON 파일."
          }
        }
      }
    },
    "A Mac disk image — opens on any Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 디스크 이미지예요. 어느 Mac에서나 열려요."
          }
        }
      }
    },
    "A Node.js program.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js 프로그램."
          }
        }
      }
    },
    "A Python program.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Python 프로그램."
          }
        }
      }
    },
    "A bit of everything": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "골고루 조금씩"
          }
        }
      }
    },
    "A calendar in the menu bar, and a tidy place for everything else.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 달력, 그리고 나머지 아이콘 정리."
          }
        }
      }
    },
    "A clean widget until you reach for it.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스를 올리기 전까지는 깔끔하게."
          }
        }
      }
    },
    "A copy of the encrypted vault. Opening it needs your Emergency Kit.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 보관함의 사본이에요. 열려면 비상 키트가 필요해요."
          }
        }
      }
    },
    "A cup while your Mac stays awake, with the time left.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 깨어 있는 동안 컵 아이콘과 남은 시간을 보여줘요."
          }
        }
      }
    },
    "A date in your own format": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 형식의 날짜"
          }
        }
      }
    },
    "A file": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일"
          }
        }
      }
    },
    "A file locked with a password you choose, to move to another Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정한 비밀번호로 잠근 파일이에요. 다른 Mac으로 옮길 때 써요."
          }
        }
      }
    },
    "A fresh unique ID": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 고유 ID"
          }
        }
      }
    },
    "A light tap on the trackpad as it opens.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열릴 때 트랙패드가 살짝 톡 울려요."
          }
        }
      }
    },
    "A little character in your menu bar that runs faster the busier your Mac gets.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 바쁠수록 더 빨리 달리는 작은 캐릭터를 메뉴 막대에 띄워요."
          }
        }
      }
    },
    "A locked app stays hidden until you’re recognized. Open it from the Dock, ⌘Tab or Mission Control and look at the camera.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠긴 앱은 얼굴을 알아볼 때까지 숨겨져 있어요. Dock, ⌘Tab, Mission Control에서 열고 카메라를 보세요."
          }
        }
      }
    },
    "A locked app’s windows stay frosted over until you’re recognized. Bring it forward or click it to look at the camera.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠긴 앱의 창은 얼굴이 인식될 때까지 흐리게 가려져요. 앱을 앞으로 가져오거나 클릭하면 카메라로 확인해요."
          }
        }
      }
    },
    "A new PDF with your Secret Key.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 키가 담긴 PDF를 새로 만들어요."
          }
        }
      }
    },
    "A notice when Do Not Disturb turns on or off.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방해 금지 모드가 켜지거나 꺼질 때 알려줘요."
          }
        }
      }
    },
    "A notice when a device connects, with each AirPod's and the case's battery. macOS asks for Bluetooth access.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 연결되면 알려줘요. AirPods는 양쪽과 케이스 배터리까지 보여줘요. macOS가 블루투스 권한을 물어봐요."
          }
        }
      }
    },
    "A quick click still works as usual.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧게 클릭하면 원래대로 동작해요."
          }
        }
      }
    },
    "A quick look at yourself through the camera.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라로 내 모습을 잠깐 확인해요."
          }
        }
      }
    },
    "A red dot and the time while Orbit records.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit이 녹화하는 동안 빨간 점과 시간을 보여줘요."
          }
        }
      }
    },
    "A remote login session.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 로그인 세션."
          }
        }
      }
    },
    "A shell, usually a Terminal window or a script.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸. 보통 터미널 창이나 스크립트예요."
          }
        }
      }
    },
    "A small badge for the app that’s playing.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 중인 앱을 작은 배지로 보여줘요."
          }
        }
      }
    },
    "A soft light gathers in the corner just before it fires.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행되기 직전에 모서리에 은은한 빛이 모여요."
          }
        }
      }
    },
    "A spelling you confirm three times becomes the default.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 표기를 세 번 확정하면 그때부터 그렇게 써요."
          }
        }
      }
    },
    "A strip of shortcuts at the bottom of the screen. It fades after a few seconds and comes back when you press a key.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아래에 단축키 안내가 떠요. 몇 초 뒤 사라지고 키를 누르면 다시 나타나요."
          }
        }
      }
    },
    "A web page or tab in Safari or another app's web view.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari나 다른 앱 웹 뷰의 웹 페이지 또는 탭."
          }
        }
      }
    },
