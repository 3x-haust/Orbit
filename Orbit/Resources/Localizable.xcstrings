    },
    "What it was changed to.": {
      "extractionState": "manual"
    },
    "What shows when you click the runner in the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 러너를 누르면 보이는 항목이에요."
          }
        }
      }
    },
    "What you click in the menu bar to see hidden icons.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 아이콘을 볼 때 메뉴 막대에서 누르는 아이콘이에요."
          }
