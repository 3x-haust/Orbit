<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lyu.orbit.fanhelper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/OrbitFanHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.lyu.orbit.fanhelper</key>
		<true/>
	</dict>
	<!-- Started at boot so a saved charge limit is enforced before Orbit opens. -->
	<key>RunAtLoad</key>
	<true/>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.lyu.orbit</string>
	</array>
</dict>
</plist>
